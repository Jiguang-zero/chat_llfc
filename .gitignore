# =============================================
# JetBrains IDE (如 CLion、IntelliJ IDEA)
# =============================================
.idea/

# =============================================
# CMake 构建相关（默认 Debug 构建目录）
# =============================================
cmake-build-debug/
cmake-build-release/

# 如果你手动指定了其它构建目录，比如 build/，也可以加上：
# build/

# =============================================
# CMake 生成的文件（通常不需要提交到 Git）
# =============================================
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Makefile
cmake_install.cmake
install_manifest.txt
*.dir/
*.a
*.so
*.dylib
*.lib
*.dll
*.pdb
*.exp

# =============================================
# 编译器生成的中间文件
# =============================================
*.o
*.obj

# =============================================
# Qt 自动生成的文件（根据需要可选忽略）
# =============================================
# 如果你不想版本控制这些自动生成的文件，可以加上：
# moc_*.cpp
# ui_*.h
# qrc_*.cpp

# =============================================
# 其他常见忽略项
# =============================================
*.log
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db
*.user
*.autosave